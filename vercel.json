{
  "crons": [
    {
      "path": "/api/automation/orchestrator",
      "schedule": "0 6 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/robots.txt",
      "destination": "/api/robots"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/rss.xml",
      "destination": "/api/rss"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/automation/orchestrator.js": {
      "maxDuration": 120
    },
    "api/automation/health.js": {
      "maxDuration": 30
    }
  }
}

